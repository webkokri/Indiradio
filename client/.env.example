# Base URL of the deployed backend (Vercel). Leave blank in development
# to use the Vite proxy defined in vite.config.js.
# Production value: https://server-dun-eta.vercel.app/api
VITE_API_BASE_URL=https://server-dun-eta.vercel.app/api

# Sanity project connection (content is managed dynamically in the Studio)
# Production project: "Indi Radio" (org: ocx88wooa), studio at https://indiradio.sanity.studio
VITE_SANITY_PROJECT_ID=7tly58zg
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01
# Only needed if the dataset is private; leave blank for a public dataset.
VITE_SANITY_READ_TOKEN=

# Fallback stream URLs, used only if a page's Sanity document has no streamUrl set
VITE_RADIO_STREAM_URL=https://stream.indiradio.ca/live
VITE_VIDEO_STREAM_URL=https://stream.indiradio.ca/tv/live.m3u8

# Social links (used only if Site Settings in the Studio has no socialLinks set)
VITE_FACEBOOK_URL=https://facebook.com/indiradio
VITE_INSTAGRAM_URL=https://instagram.com/indiradio
VITE_YOUTUBE_URL=https://youtube.com/@indiradio
