# Sanity (write access, used only by the backend — never exposed to the browser)
SANITY_PROJECT_ID=your-project-id
SANITY_DATASET=production
SANITY_WRITE_TOKEN=sk_your_write_token

# Allowed origins for CORS (comma separated)
ALLOWED_ORIGINS=https://indiradio.ca,http://localhost:5173

# Optional: SMTP email notifications for new contact submissions.
# Leave SMTP_HOST blank to skip sending email (submissions are still saved to Sanity).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_FROM_EMAIL=no-reply@indiradio.ca
CONTACT_TO_EMAIL=hello@indiradio.ca
